{
	"name": "@webappwiz/arbor",
	"version": "0.0.0",
	"description": "Runs several AI coding agents on one repository at once, each in its own git worktree",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/arbor"
	},
	"type": "module",
	"module": "index.ts",
	"bin": {
		"arbor": "./index.ts"
	},
	"exports": {
		".": "./index.ts",
		"./config": "./config.ts"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/cmd": "workspace:*",
		"@webappwiz/http": "workspace:*",
		"@webappwiz/log": "workspace:*",
		"@webappwiz/md": "workspace:*",
		"@webappwiz/system": "workspace:*",
		"@webappwiz/t": "workspace:*",
		"@webappwiz/time": "workspace:*"
	},
	"devDependencies": {
		"@tailwindcss/oxide": "^4.3.3",
		"@testing-library/react": "^16.3.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@webappwiz/browser": "workspace:*",
		"@webappwiz/events": "workspace:*",
		"@webappwiz/react": "workspace:*",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3"
	},
	"scripts": {
		"build": "bun run build.ts"
	}
}
