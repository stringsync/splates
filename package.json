{
	"name": "@webappwiz/arbor",
	"version": "0.0.0",
	"description": "Runs several AI coding agents on one repository at once, each in its own git worktree",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/arbor"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"arbor": "./dist/index.js"
	},
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./config": {
			"bun": "./config.ts",
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		}
	},
	"engines": {
		"bun": ">=1.3"
	},
	"files": [
		"dist",
		"**/*.ts",
		"**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"dev/index.html",
		"dev/styles.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@tailwindcss/oxide": "^4.3.3",
		"@webappwiz/cmd": "workspace:^",
		"@webappwiz/disposable": "workspace:^",
		"@webappwiz/events": "workspace:^",
		"@webappwiz/http": "workspace:^",
		"@webappwiz/log": "workspace:^",
		"@webappwiz/md": "workspace:^",
		"@webappwiz/react": "workspace:^",
		"@webappwiz/system": "workspace:^",
		"@webappwiz/t": "workspace:^",
		"@webappwiz/time": "workspace:^",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@webappwiz/browser": "workspace:^",
		"@testing-library/react": "^16.3.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4"
	}
}
