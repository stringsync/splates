{
	"name": "@stringsync/splates",
	"version": "2.0.10",
	"description": "Runs several AI coding agents on one repository at once, each in its own git worktree",
	"license": "MIT",
	"author": "stringsync LLC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stringsync/splates.git",
		"directory": "packages/splates"
	},
	"type": "module",
	"module": "index.ts",
	"bin": {
		"splates": "./index.ts",
		"arbor": "./index.ts",
		"rec": "./rec.ts"
	},
	"exports": {
		".": "./index.ts",
		"./config": "./config.ts",
		"./mirror": "./mirror.ts"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@splates/server": "workspace:*",
		"@evals/evals": "workspace:*",
		"@mono/rec": "workspace:*",
		"core": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	}
}
