{
	"name": "@stringsync/splates",
	"version": "0.0.52",
	"description": "Runs several AI coding agents on one repository at once, each in its own git worktree",
	"license": "MIT",
	"author": "stringsync LLC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stringsync/splates.git",
		"directory": "packages/splates"
	},
	"type": "module",
	"module": "index.ts",
	"bin": {
		"splates": "./index.ts",
		"arbor": "./index.ts"
	},
	"exports": {
		".": "./index.ts"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@stringsync/splates-server": "workspace:*",
		"webappwiz": "0.0.47",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14"
	},
	"scripts": {
		"build": "bun run --cwd ../web build"
	}
}
