{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!skills-lock.json",
			"!**/catalog/*/evals",
			"!.vet/rules/*/evals",
			"!packages/core"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"conventions": [
							{
								"selector": {
									"kind": "typeLike"
								},
								"match": "([^I].*|I|I[^A-Z].*)"
							},
							{
								"selector": {
									"kind": "variable"
								},
								"match": "(.{2,}|[ijk])"
							},
							{
								"selector": {
									"kind": "functionParameter"
								},
								"match": "(.{2,}|[ijk])"
							},
							{
								"selector": {
									"kind": "any"
								},
								"match": ".*"
							}
						]
					}
				},
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/packages/**"],
								"message": "Import the package's public API (its name and an exports subpath) instead of reaching into packages/."
							}
						]
					}
				}
			},
			"correctness": {
				"noUndeclaredDependencies": "error"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["**/react/**"],
			"linter": {
				"domains": {
					"react": "recommended"
				}
			}
		},
		{
			"includes": ["packages/web/**/*.test.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@testing-library/react": "Import from the shared testing-library wrapper instead: it registers the DOM before loading React DOM, preserving onChange across test files."
								},
								"patterns": [
									{
										"group": ["**/packages/**"],
										"message": "Import the package's public API (its name and an exports subpath) instead of reaching into packages/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/web/**"],
			"linter": {
				"domains": {
					"react": "recommended"
				}
			}
		},
		{
			"includes": [
				"packages/web/components/ui/**",
				"packages/web/components/assistant-ui/**",
				"packages/web/hooks/**"
			],
			"linter": {
				"enabled": false
			}
		}
	]
}
