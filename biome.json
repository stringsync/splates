{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!.agents", "!.wiz/scry/*/evals"]
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"conventions": [
							{
								"selector": { "kind": "typeLike" },
								"match": "([^I].*|I|I[^A-Z].*)"
							},
							{
								"selector": { "kind": "variable" },
								"match": "(.{2,}|[ijk])"
							},
							{
								"selector": { "kind": "functionParameter" },
								"match": "(.{2,}|[ijk])"
							},
							{ "selector": { "kind": "any" }, "match": ".*" }
						]
					}
				},
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/packages/**"],
								"message": "Import the package's public API (e.g. '@stringsync/splates/config') instead of reaching into packages/."
							}
						]
					}
				}
			},
			"correctness": { "noUndeclaredDependencies": "error" }
		}
	},
	"formatter": { "enabled": true },
	"overrides": [
		{
			"includes": [
				"packages/splates/dev/components/ui/**",
				"packages/splates/dev/components/assistant-ui/**",
				"packages/splates/dev/hooks/**"
			],
			"linter": { "enabled": false }
		}
	]
}
